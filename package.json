{
  "name": "2022",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "spotify:connect": "node --env-file-if-exists=.env.local scripts/connect-spotify.mjs",
    "test:spotify": "node --test tests/music.test.mjs tests/connect-spotify.test.mjs tests/listeningTime.test.mjs",
    "dev": "node scripts/build-memory.mjs && next dev",
    "build": "node scripts/build-memory.mjs && next build",
    "build:memory": "node scripts/build-memory.mjs",
    "test:memory": "node --test experiments/memory/tests/*.test.js",
    "analyze": "node scripts/build-memory.mjs && ANALYZE=true next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern .next --ignore-pattern out --ignore-pattern public",
    "format": "prettier --write .",
    "danger": "danger",
    "lighthouse": "node scripts/lighthouse.mjs",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit"
  },
  "dependencies": {
    "@react-hook/copy": "2.0.1",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "2.8.2",
    "@vercel/speed-insights": "1.3.1",
    "framer-motion": "12.43.0",
    "gray-matter": "4.0.3",
    "lenis": "1.3.27",
    "next": "15.5.28",
    "next-mdx-remote": "6.0.0",
    "next-seo": "6.8.0",
    "next-sitemap": "4.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5"
  },
  "overrides": {
    "flatted": "^3.4.4",
    "sharp": "0.35.5",
    "undici": "^6.29.1",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0",
    "postcss": "8.5.32",
    "source-map-js": "^1.2.2",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "js-yaml@3": "^3.15.2",
    "js-yaml@4": "^4.3.2",
    "zod@4": "^4.6.7",
    "picomatch@2": "^2.3.2",
    "postcss-selector-parser@6": "^6.1.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "15.5.28",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/sanitize-html": "2.16.2",
    "autoprefixer": "10.6.2",
    "danger": "13.0.10",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "3.4.19",
    "tailwindcss-touch": "1.0.1",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "lighthouse": "13.6.0",
    "chrome-launcher": "1.2.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.19.0"
  }
}
